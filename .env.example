# ParaliWatch Environment Configuration (Placeholders only)

# NASA FIRMS API Map Key (Obtain from https://firms.modaps.eosdis.nasa.gov/api/map_key/)
# REQUIRED for running the automated data pipeline (src/update_data.py)
FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# Next.js Public Raw Data URL (Optional fallback for public static CDN/GitHub Raw)
# Leave empty to use local public/data/ folder by default
NEXT_PUBLIC_DATA_BASE_URL=
